# 复制为 .env 后按需修改。优先级：.env > 代码默认值
DEBUG=True
SECRET_KEY=please-change-this-in-production
ALLOWED_HOSTS=*

# 数据库：留空 DB_HOST 则使用 SQLite（开箱即用）；填写则使用 MySQL
DB_NAME=family_ledger
DB_USER=root
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# Redis（缓存 / 限流 / Django-Q 队列）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 前端地址（CORS）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 智能分析（可选，默认关闭）
# 不填 AI_API_KEY 时，报告页「智能分析」自动使用本地规则引擎，功能完全不受影响。
# 兼容 OpenAI /chat/completions 协议：DeepSeek、通义、Moonshot、本地 vLLM/Ollama 均可。
AI_ENABLED=False
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=20
AI_CACHE_TTL=900

# 短信验证码（找回密码 / 绑定手机号）
# 默认 console：验证码只写进后端日志、不真发短信，个人主体也能完整走通找回密码流程。
# 有企业资质后改 SMS_PROVIDER=aliyun 或 tencent，配齐下面几项即可真发短信，代码无需改动。
SMS_PROVIDER=console
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_APP_ID=          # 仅腾讯云：SDKAppID
SMS_SIGN_NAME=       # 短信签名，如「钱来钱往」
SMS_TEMPLATE_RESET=  # 重置密码模板 ID
SMS_TEMPLATE_BIND=   # 绑定手机号模板 ID
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300        # 验证码有效期（秒）
SMS_SEND_INTERVAL=60    # 重发间隔（秒）
SMS_MAX_TRIES=5         # 单条验证码最多校验次数
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_DAILY_LIMIT_PER_IP=30

# 会员权益闸门：False = 付费权益对所有人开放（先用起来攒粘性）。
# 要开始收费时改成 True，报表长周期 / AI 分析 / 批量导入 / 成员上限会按会员状态受限。
VIP_GATED=False

# 微信支付（会员开通 / 续费）
# 关掉时：DEBUG=True 走「下单即开通」的本地联调模式，正式环境直接拒绝下单。
WXPAY_ENABLED=False
WXPAY_MCHID=
# 公众号（微信内 JSAPI 支付 + 网页授权取 openid）
# 这两项同时也是 H5 端「微信一键登录」的凭据：留空时登录页会自动隐藏微信登录按钮。
# 前置条件：公众号须具备「网页授权」接口权限，并在公众号后台
#   设置与开发 → 公众号设置 → 功能设置 → 网页授权域名
# 填上已备案的域名（如 your-domain.com，不带 https，不带路径）。
WXPAY_APPID=
WXPAY_APP_SECRET=
# 小程序（留空则复用公众号配置）
# 注意：WXPAY_MINI_APPID / WXPAY_MINI_SECRET 同时也是「微信一键登录」的凭据，
# 只需配这两项即可使用小程序免密登录，不必开启 WXPAY_ENABLED（支付是另一回事）。
WXPAY_MINI_APPID=
WXPAY_MINI_SECRET=
# 商户平台 → API 安全：APIv3 密钥、API 证书序列号、证书私钥
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
# 支付结果通知地址（公网 https，微信要能访问到）
WXPAY_NOTIFY_URL=https://your-domain.com/api/v1/membership/notify/wechat/
# H5 支付完成后回跳的前端页面
WXPAY_H5_REDIRECT_URL=https://your-domain.com/
