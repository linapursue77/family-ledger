# 生产环境变量模板 —— 复制为 deploy/.env 后逐项修改，切勿提交到仓库
#   cp deploy/env.production.example deploy/.env

# ---------------- Django ----------------
# ★ 必须 False：True 会把 SQL、路径、配置摊在错误页上
DEBUG=False
# ★ 必须换：openssl rand -base64 64
# 泄露 = JWT 可被伪造 = 任何人都能读你家账本
SECRET_KEY=请替换为随机长字符串
# 逗号分隔，填域名与服务器 IP
ALLOWED_HOSTS=your.domain.com,1.2.3.4
CSRF_TRUSTED_ORIGINS=https://your.domain.com
# 同源部署（nginx 反代 /api）不需要 CORS；只有前后端分域名时才填
CORS_ALLOWED_ORIGINS=

# ---------------- 数据库 ----------------
# compose 内部服务名，不要改
DB_HOST=db
DB_PORT=3306
DB_NAME=family_ledger
DB_USER=fl
DB_PASSWORD=改成强密码
DB_ROOT_PASSWORD=改成另一个强密码

# ---------------- Redis / 异步任务 ----------------
REDIS_HOST=redis
REDIS_PORT=6379
Q_WORKERS=2

# ---------------- 前端静态托管 ----------------
# 0 = nginx 发前端（推荐，本 compose 默认）
# 1 = Django 同时发前端与接口，单端口，适合内网试用 / cloudflared 隧道
SERVE_WEB=0
WEB_DIST=/app/frontend/dist

# ---------------- 构建期（不参与运行）----------------
# 后端 Python 依赖的安装源，只在公司内网/国内拉官方 PyPI 慢时才需要改。
# 前端依赖不在此列：node_modules 从不上服务器，dist 随仓库提交。
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
