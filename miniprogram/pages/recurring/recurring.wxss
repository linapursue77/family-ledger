/* 页面容器：与 H5 顶部留白一致 */
.rec-page {
  padding: 0 24rpx;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}
.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-body);
}
.top-close {
  font-size: 48rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
  line-height: 1;
}

.rec-note {
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.tip {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 200rpx;
}

/* 卡片 */
.rec-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.rec-card.off {
  opacity: 0.55;
}
.rc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.rc-icon {
  font-size: 40rpx;
  width: 44rpx;
  text-align: center;
}
.rc-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #0d0d0d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rc-amount {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.rc-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.rc-freq {
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary-dark);
}
.rc-next {
  color: var(--text-sub);
}
.rc-err {
  color: var(--expense);
}

.rc-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.rc-ops {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider);
  font-size: 26rpx;
  color: var(--primary);
  /* 不换行：gap 在部分微信 WebView 下与 flex 配合不稳会导致串行，改用 margin 间距 */
  flex-wrap: nowrap;
  white-space: nowrap;
}
.rc-op {
  color: var(--primary);
  flex-shrink: 0;
  margin-right: 32rpx;
}
.rc-op.danger {
  color: var(--expense);
  margin-left: auto;
  margin-right: 0;
}

/* 浮动新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #7f77dd;
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(127, 119, 221, 0.4);
  z-index: 40;
}

/* ---------- 表单弹窗 ---------- */
.sheet {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}
.sheet-close {
  font-size: 40rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
  line-height: 1;
}

.type-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.type-pill {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.type-pill.active {
  background: var(--primary-dark);
  color: #fff;
  font-weight: 600;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin: 24rpx 0 12rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field-label {
  width: 200rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.field-row input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-body);
}
.field-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-body);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  margin-top: 16rpx;
}
.chips-row {
  margin-top: 8rpx;
}
.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--text-body);
  margin-right: 0;
}
.chip.on {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary-dark);
  font-weight: 600;
}
.chip-inline {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}
.mini-input {
  width: 100rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  background: #fff;
}

.check-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}
.check-line switch {
  transform: scale(0.85);
}

.btn-primary {
  margin-top: 32rpx;
}
.btn-secondary {
  margin-top: 16rpx;
  background: #f1efe8;
  color: var(--text-sub);
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 22rpx 0;
}