/*
 * 记账页样式：逐项对齐 H5 frontend/src/views/Add.vue。
 * 换算基准 1px = 2rpx，数值与 H5 一一对应，改一边记得同步另一边。
 */
.add-form {
  padding: 32rpx 32rpx 160rpx;
}
.form-group {
  margin-bottom: 32rpx;
  /* 给子级 input 一个明确的宽度基准，避免 max-width:100% 落空 */
  width: 100%;
  box-sizing: border-box;
}
.form-label {
  display: block;
  font-size: 24rpx;
  color: #888780;
  margin-bottom: 12rpx;
}
/* 编辑态提示条 */
.edit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #eeedfe;
}
.edit-tip {
  font-size: 24rpx;
  color: #534ab7;
  font-weight: 600;
}
.edit-cancel {
  font-size: 24rpx;
  color: #888780;
}

/* 顶部类型条：文字胶囊，选中实色，右侧 ＋ 新增分类 */
.type-bar {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 0 20rpx;
  /* H5 预留了横向滚动，小程序同样处理，分类多时不换行 */
  white-space: nowrap;
}
.type-pill {
  flex: none;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #5f5e5a;
  white-space: nowrap;
}
.type-pill.active {
  background: #534ab7;
  color: #fff;
  font-weight: 600;
}
.bar-spacer {
  flex: 1;
}
.bar-add {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #534ab7;
  font-size: 36rpx;
  line-height: 1;
  background: #eeedfe;
}

/* 分类宫格：5 列，卡片之间留 20rpx 间隙（对齐 H5 的 gap:10px）。
   之前用 width:20% + 无间隙，卡片会紧紧贴在一起，和 H5 观感差一截。 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-bottom: 8rpx;
}
.category-cell {
  /* 5 列 + 4 个 20rpx 间隙：(100% - 80rpx) / 5 */
  width: calc((100% - 80rpx) / 5);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 4rpx 16rpx;
  border-radius: 24rpx;
  /* H5 一致：未选中也是白底 + 透明描边，避免布局跳动 */
  background: #fff;
  border: 1rpx solid transparent;
}
.cat-icon {
  font-size: 52rpx;
  line-height: 1;
}
.cat-name {
  font-size: 22rpx;
  color: #2c2c2a;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.category-cell.active {
  background: #eeedfe;
  border-color: #7f77dd;
}
.category-cell.active .cat-name {
  color: #534ab7;
  font-weight: 600;
}

/* 金额 · 日期同卡一行 */
.amount-note-card {
  margin-top: 24rpx;
  background: #fff;
  border: 1rpx solid #d3d1c7;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}
.an-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.an-label {
  flex: none;
  font-size: 26rpx;
  color: #5f5e5a;
}
.an-amount {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.amount-symbol {
  flex: none;
  font-size: 36rpx;
  font-weight: 500;
  color: #2c2c2a;
}
.amount-input {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 500;
  color: #2c2c2a;
  padding: 12rpx 8rpx;
}
.an-sep {
  flex: none;
  width: 2rpx;
  height: 36rpx;
  background: #e8e6dc;
}
/*
 * 日期胶囊：与页内账本 / 账户 chips 同一套语言（浅灰底 + 全圆角 + 深灰字），
 * 不再做成「白底细边输入框」——那种方框浮在圆角卡片里像原生控件，很跳。
 */
.an-date {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f1efe8;
  font-size: 26rpx;
  color: #2c2c2a;
  white-space: nowrap;
}
/* 日期数字等宽，切换日期时胶囊宽度不跳动 */
.an-date-tx {
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}
/* 日历图标：实心小方块画成的日历，比 ▣ 字符更清楚，也不引入图标库 */
.an-date-ic {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 3rpx solid #888780;
  border-top-width: 8rpx;
  box-sizing: border-box;
}
/* 展开态：整颗变浅紫 + 主色字，与 chips 的选中态一致 */
.an-date.on {
  background: #eeedfe;
  color: #534ab7;
  font-weight: 600;
}
.an-date.on .an-date-ic {
  border-color: #7f77dd;
}

/* 自绘日历 */
.date-panel {
  margin-top: 12rpx;
  padding: 20rpx 24rpx 16rpx;
  background: #fff;
  border: 1rpx solid #d3d1c7;
  border-radius: 16rpx;
}
.dp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2a;
}
.dp-nav {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #eeedfe;
  color: #534ab7;
  font-size: 32rpx;
}
.dp-nav.off {
  background: #f1efe9;
  color: #cfcdc4;
}
.dp-week {
  display: flex;
  padding-bottom: 8rpx;
  font-size: 22rpx;
  color: #b4b2a9;
}
.dp-week text {
  width: 14.28%;
  text-align: center;
}
.dp-grid {
  display: flex;
  flex-wrap: wrap;
}
.dp-cell {
  width: 14.28%;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2c2c2a;
}
.dp-cell.muted {
  color: #cfcdc4;
}
.dp-cell.off {
  color: #e4e2da;
}
.dp-cell.today {
  /* H5 用 inset 阴影圈出今天，避免边框撑出 1px 位移 */
  box-shadow: inset 0 0 0 2rpx #d3d1c7;
}
.dp-cell.on {
  background: #534ab7;
  color: #fff;
  font-weight: 600;
  box-shadow: none;
}
.dp-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0eee6;
}
.dp-btn {
  font-size: 26rpx;
  color: #888780;
}
.dp-btn.primary {
  color: #534ab7;
  font-weight: 600;
}

/* 备注栏与金额卡之间多留一拍 */
.note-group {
  margin-top: 40rpx;
}
.form-input {
  /*
   * ★ 不要设 width:100%：小程序 input 默认 block 级满宽，
   * 再叠 width:100% + padding 时部分基础库按 content-box 算，
   * 结果比容器宽出一截，右侧被裁掉、文字显示不全。
   * 改为只给 max-width + border-box，宽度由父级决定，内距不再撑宽。
   */
  display: block;
  box-sizing: border-box;
  width: auto;
  max-width: 100%;
  /* 显式高度：input 的 padding 在部分基础库上不撑开盒子，只靠 padding 会压成一条细线 */
  height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #2c2c2a;
  background: #fafbfc;
}
/* 备注历史：同一分类下最近用过的备注，点一下直接填入 */
.history-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.history-chip {
  padding: 10rpx 20rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 999rpx;
  background: #faf9f5;
  font-size: 24rpx;
  color: #5f5e5a;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-chip.on {
  background: #eeedfe;
  border-color: #7f77dd;
  color: #534ab7;
}

/* 快捷条与账户条：白色小 chips，横向滑动不换行（对齐 H5 的 overflow-x）。
   之前 flex-wrap 换行会把「计入共同支出」挤到第二行，观感和 H5 不一致。 */
.quick-bar,
.account-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  overflow-x: auto;
  padding: 4rpx 0;
  white-space: nowrap;
}
.q-chip {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 16rpx;
  background: #fff;
  font-size: 24rpx;
  color: #2c2c2a;
  white-space: nowrap;
}
.q-chip.on {
  background: #eeedfe;
  border-color: #7f77dd;
  color: #534ab7;
  font-weight: 600;
}
.q-chip .q-tag {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #1d9e75;
}

/* 按钮 */
.form-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}
.btn-primary,
.btn-secondary {
  width: 100%;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.4;
  text-align: center;
}
.btn-primary {
  background: var(--primary, #7f77dd);
  color: #fff;
  font-weight: 600;
}
.btn-primary.disabled {
  opacity: 0.6;
}
.btn-secondary {
  background: #f1efe8;
  color: #5f5e5a;
}

/* ---------------- 新增分类弹层 ---------------- */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 60;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  max-height: 80vh;
}
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2a;
}
.sheet-close {
  color: #b4b2a9;
  font-size: 32rpx;
  padding: 0 8rpx;
}
.icon-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.icon-opt {
  /* 8 列 + 7 个 12rpx 间隙 */
  width: calc((100% - 84rpx) / 8);
  box-sizing: border-box;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f7f6f2;
  font-size: 36rpx;
}
.icon-opt.on {
  background: #eeedfe;
  box-shadow: inset 0 0 0 2rpx #7f77dd;
}
.cat-label {
  margin-top: 24rpx;
}
.cat-hint {
  font-size: 24rpx;
  color: #888780;
  margin-top: 20rpx;
  line-height: 1.5;
}
