.asset-card {
  background: linear-gradient(135deg, #7f77dd, #534ab7);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 24rpx 16rpx;
}
.asset-card .label {
  font-size: 22rpx;
  opacity: 0.8;
}
.family-name {
  font-size: 44rpx;
  font-weight: 600;
  margin: 8rpx 0;
}
.fam-meta {
  font-size: 22rpx;
  opacity: 0.9;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-body);
}
.add-btn {
  font-size: 26rpx;
  color: var(--primary);
}

.member-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.member-row:last-child {
  border-bottom: none;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.member-info {
  flex: 1;
}
.member-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.role-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.role-tag.owner {
  background: var(--primary-light);
  color: var(--primary);
}
.self-tag {
  font-size: 20rpx;
  color: var(--text-muted);
}
.member-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.arrow {
  font-size: 34rpx;
  color: #c8c6c0;
}

.invite-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.invite-row:last-child {
  border-bottom: none;
}
.invite-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.invite-name {
  font-size: 28rpx;
}
.invite-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.link-btn {
  font-size: 26rpx;
  color: var(--primary);
}
.link-btn.danger,
.action-item.danger {
  color: var(--expense);
}

.empty-sm {
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 24rpx 0 8rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field-label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.field-row input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.field-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-main);
}

.form-note {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  padding-top: 16rpx;
}

.token-box {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f6f3;
  border-radius: 16rpx;
}
.token-label {
  font-size: 22rpx;
  color: var(--text-sub);
}
.token-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin: 12rpx 0;
  word-break: break-all;
}
.token-copy {
  font-size: 26rpx;
  color: var(--primary);
}
/*
 * 邀请分享按钮：微信生态里「分享/转发」统一用微信绿（#07c160），
 * 用户对绿色按钮的预期就是"发出去"，用主色紫会与保存类按钮混淆。
 * 原生 button 的默认边框、背景、宽度要一并重置，否则会比其他按钮胖一圈。
 */
.share-btn {
  margin: 20rpx 0 16rpx;
  padding: 22rpx 0;
  width: 100%;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: normal;
  border: none;
}
.share-btn::after {
  border: none;
}
/* 转发箭头：换个更贴近微信的图标语义，不引图标库 */
.share-ic {
  font-size: 30rpx;
  margin-right: 4rpx;
}
.share-btn:active {
  background: #06ad56;
}

/* ---------- 授权项（邀请预设 / 成员授权共用） ---------- */
.perm-block {
  margin: 24rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: #faf9f6;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}
.perm-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 600;
  padding-bottom: 8rpx;
}
.perm-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.perm-row:last-child {
  border-bottom: none;
}
.pr-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.pr-label {
  font-size: 28rpx;
  color: var(--text-main);
}
.pr-desc {
  font-size: 21rpx;
  color: var(--text-muted);
  line-height: 1.45;
}
/* 二选一胶囊：与页面其它 chips 同一套语言 */
.pr-opts {
  flex: none;
  display: flex;
  gap: 8rpx;
}
.pr-opt {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  background: #fff;
  border: 1rpx solid var(--border);
  white-space: nowrap;
}
.pr-opt.on {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary-dark);
  font-weight: 600;
}
/* 开关类：纯 CSS 小开关，避免原生 switch 撑高行 */
.mini-switch {
  flex: none;
  width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #dcdad3;
  position: relative;
  transition: background 0.2s;
}
.mini-switch .ms-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.16);
  transition: transform 0.2s;
}
.mini-switch.on {
  background: var(--income);
}
.mini-switch.on .ms-dot {
  transform: translateX(32rpx);
}
.perm-note {
  font-size: 21rpx;
  color: var(--text-muted);
  line-height: 1.5;
  padding-top: 12rpx;
}

.action-item {
  padding: 28rpx 4rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--divider);
}
