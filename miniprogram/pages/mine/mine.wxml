<view class="page">
  <!-- 用户卡：未登录时整卡可点，作为登录入口 -->
  <view class="card user-card" bindtap="onUserTap">
    <view class="avatar">{{isLoggedIn ? (user.nickname ? user.nickname[0] : '财') : '👤'}}</view>
    <view class="user-info">
      <text class="user-name">{{isLoggedIn ? (user.nickname || '未设置昵称') : '点击登录'}}</text>
      <text class="user-family text-muted">{{isLoggedIn ? (family.name || '我的家庭') : '登录后同步家庭账本'}}</text>
    </view>
    <text wx:if="{{!isLoggedIn}}" class="arrow">›</text>
  </view>

  <!-- 账户列表 -->
  <view class="card section">
    <view class="section-head">
      <text class="section-title">我的账户</text>
      <text wx:if="{{isLoggedIn}}" class="add-btn" bindtap="openAdd">＋ 新增</text>
    </view>
    <block wx:if="{{isLoggedIn}}">
    <view class="list-item" wx:for="{{accounts}}" wx:key="id">
      <text class="acc-icon">{{item.icon}}</text>
      <view class="acc-info">
        <text class="acc-name">{{item.name}}</text>
        <text class="acc-book text-muted">{{item.book_type}}</text>
      </view>
      <text class="acc-balance">¥{{item.balanceText}}</text>
    </view>
    <view wx:if="{{!accounts.length}}" class="empty">暂无账户，点击右上角新增</view>
    </block>
    <view wx:else class="empty">登录后查看我的账户</view>
  </view>

  <!-- 更多功能 -->
  <view class="card section">
    <view class="section-head">
      <text class="section-title">更多功能</text>
    </view>
    <view class="list-item" bindtap="goAccounts">
      <text class="acc-icon">🏦</text>
      <text class="acc-name">账户管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" bindtap="goLoans">
      <text class="acc-icon">🤝</text>
      <text class="acc-name">借钱来往</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" bindtap="goReturns">
      <text class="acc-icon">📈</text>
      <text class="acc-name">收益管理</text>
      <text class="arrow">›</text>
    </view>
    <!-- 定时记账：与 H5 入口同名同位置 -->
    <view class="list-item" bindtap="goRecurring">
      <text class="acc-icon">⏰</text>
      <text class="acc-name">定时记账</text>
      <text class="item-value">{{recText}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" bindtap="goFamily">
      <text class="acc-icon">🏠</text>
      <text class="acc-name">家庭管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" bindtap="goImport">
      <text class="acc-icon">📥</text>
      <text class="acc-name">账单导入</text>
      <text class="arrow">›</text>
    </view>
    <!-- 分享给好友：必须真 button，微信只认 open-type="share" 拉起会话面板。
         与主包/-pc2 的 H5「分享给好友」入口同名同位置 -->
    <button class="list-item share-item" open-type="share" hover-class="share-hover">
      <text class="acc-icon">📢</text>
      <text class="acc-name">分享给好友</text>
      <text class="arrow">›</text>
    </button>
  </view>

  <!-- 登录密码：微信一键登录的账号默认没有密码，设置后可在网页版登录（仅登录后展示） -->
  <view wx:if="{{isLoggedIn}}" class="card section">
    <view class="section-head" bindtap="openPwd">
      <text class="section-title">🔑 {{pwdTitle}}</text>
      <text class="add-btn">{{pwdText}}</text>
    </view>
    <view wx:if="{{showPwd}}" class="pwd-form">
      <view wx:if="{{hasPassword}}" class="field-row">
        <text class="field-label">当前密码</text>
        <input password placeholder="请输入当前密码" value="{{pwdOld}}" bindinput="onPwdOld" />
      </view>
      <view class="field-row">
        <text class="field-label">新密码</text>
        <input password placeholder="字母+数字，至少 6 位" value="{{pwdNew}}" bindinput="onPwdNew" />
      </view>
      <view class="field-row">
        <text class="field-label">确认密码</text>
        <input password placeholder="再输入一次新密码" value="{{pwdConfirm}}" bindinput="onPwdConfirm" />
      </view>
      <button class="btn-primary {{pwdSaving ? 'disabled' : ''}}" bindtap="onSavePwd">
        {{pwdSaving ? '保存中…' : '保存'}}
      </button>
      <view class="pwd-note">用微信登录的账号默认没有密码，设置后即可用「手机号 + 密码」在网页版登录。</view>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-area">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
  <view wx:else class="guest-tip">先随便逛逛，数据都在登录后等你 👋</view>

  <!-- 新增账户弹窗 -->
  <view wx:if="{{showAdd}}" class="sheet-mask" bindtap="closeAdd">
    <view class="sheet" catchtap>
      <view class="sheet-head">
        <text class="sheet-title">新增账户</text>
        <text class="sheet-close" bindtap="closeAdd">×</text>
      </view>
      <view class="field-row">
        <text class="field-label">名称</text>
        <input placeholder="如：招商银行" value="{{newName}}" bindinput="onName" />
      </view>
      <view class="field-row">
        <text class="field-label">类型</text>
        <picker range="{{accountTypes}}" range-key="label" value="{{newTypeIndex}}" bindchange="onType">
          <view class="field-value">{{accountTypes[newTypeIndex].label}} ›</view>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">账本</text>
        <picker range="{{bookTypes}}" range-key="label" value="{{newBookIndex}}" bindchange="onBook">
          <view class="field-value">{{bookTypes[newBookIndex].label}} ›</view>
        </picker>
      </view>
      <view class="field-row">
        <text class="field-label">余额</text>
        <input type="digit" placeholder="0.00" value="{{newBalance}}" bindinput="onBalance" />
      </view>
      <button class="btn-primary {{saving ? 'disabled' : ''}}" bindtap="onSaveAccount">
        {{saving ? '保存中…' : '保存'}}
      </button>
    </view>
  </view>
</view>