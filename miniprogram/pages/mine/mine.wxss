.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}
.user-info {
  display: flex;
  flex-direction: column;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}
.user-family {
  font-size: 26rpx;
  margin-top: 6rpx;
}
.section {
  padding: 28rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}
.arrow {
  font-size: 34rpx;
  color: #c8c6c0;
}
.add-btn {
  color: var(--primary);
  font-size: 28rpx;
}
.acc-icon {
  font-size: 40rpx;
}
.acc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.acc-name {
  font-size: 30rpx;
  font-weight: 600;
}
.acc-book {
  font-size: 24rpx;
}
.acc-balance {
  font-weight: 700;
  font-size: 30rpx;
}
.item-value {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-left: auto;
  padding-right: 16rpx;
}
/* 分享入口必须是真 button（open-type="share"），这里把 button 默认样式清掉，
   让它跟其它 view 列表项长得一模一样 */
.share-item {
  width: 100%;
  margin: 0;
  padding: 24rpx 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  text-align: left;
  font-size: 30rpx;
  color: var(--text-main);
}
.share-item::after {
  border: none;
}
.share-hover {
  background: #f6f5f1;
}
.pwd-form {
  padding: 8rpx 0 4rpx;
}
.pwd-note {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.6;
  padding: 8rpx 0 0;
}
.logout-area {
  padding: 40rpx 24rpx;
}
.btn-logout {
  background: #fff;
  color: var(--expense);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field-label {
  font-size: 28rpx;
  color: var(--text-sub);
}
.field-value {
  font-size: 28rpx;
}
.field-row input {
  font-size: 28rpx;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}
/* 未登录态 */
.user-card .arrow {
  font-size: 40rpx;
  color: #c8c6c0;
}
.guest-tip {
  text-align: center;
  font-size: 24rpx;
  color: #b0aeaa;
  padding: 24rpx 0 48rpx;
}
