<view class="login-page">
  <view class="brand">
    <view class="brand-icon">💰</view>
    <view class="brand-name">钱来钱往记账</view>
    <view class="brand-sub">一起记账 · 平衡透明与隐私</view>
  </view>

  <!-- 主入口：微信一键登录（所有主体可用，用户无感） -->
  <button
    class="wx-btn {{loading ? 'is-loading' : ''}}"
    disabled="{{loading}}"
    bindtap="onWxLogin"
  >
    <text wx:if="{{!loading}}">微信一键登录</text>
    <text wx:else>登录中…</text>
  </button>

  <!-- 手机号快捷验证入口：已屏蔽。
       该能力需「非个人主体 + 已认证 + 已开通付费」，本项目为个人主体（principal_type=0），
       调用必然失败。若日后主体变更为企业/个体工商户，把下面整段注释取消即可恢复。
  <button
    class="wx-btn ghost"
    open-type="getPhoneNumber"
    bindgetphonenumber="onGetPhone"
    disabled="{{loading}}"
  >
    微信手机号登录
  </button>
  -->

  <view class="divider" bindtap="togglePwd">
    <text>{{showPwd ? '收起密码登录' : '用手机号密码登录'}}</text>
  </view>

  <!-- 兜底入口：老用户/无微信环境 -->
  <view class="form card" wx:if="{{showPwd}}">
    <view class="field">
      <text class="label">手机号</text>
      <input
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhone"
      />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPassword"
      />
    </view>
    <button class="btn-primary {{loading ? 'disabled' : ''}}" bindtap="onLogin">
      {{loading ? '登录中…' : '登 录'}}
    </button>
    <view class="hint">演示账号：13800138000 / test123456</view>
  </view>
</view>
