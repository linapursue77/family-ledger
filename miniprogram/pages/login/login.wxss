.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  background: linear-gradient(160deg, #eeedfe 0%, #f1efe8 60%);
}
.brand {
  text-align: center;
  margin-bottom: 64rpx;
}
.brand-icon {
  font-size: 88rpx;
}
.brand-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-top: 16rpx;
}
.brand-sub {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}
/* 微信一键登录：主按钮 */
.wx-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border-radius: var(--radius-btn);
  background: linear-gradient(135deg, #7f77dd, #534ab7);
  box-shadow: 0 8rpx 24rpx rgba(83, 74, 183, 0.25);
  margin-bottom: 24rpx;
}
.wx-btn::after {
  border: none; /* 去掉小程序 button 默认边框 */
}
.wx-btn.ghost {
  color: #534ab7;
  background: #fff;
  border: 1rpx solid #c9c4f0;
  box-shadow: none;
  font-weight: 500;
}
.wx-btn.is-loading {
  opacity: 0.7;
}
/* 微信按钮下方的一行指引：明确「新用户才点这里」，避免老用户误建空账号 */
.wx-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  padding: 0 40rpx;
  margin-top: 16rpx;
}
.divider {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 12rpx 0 4rpx;
}
.form {
  padding: 40rpx 32rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}
.field input {
  border: 1rpx solid var(--border);
  border-radius: var(--radius-btn);
  padding: 24rpx;
  font-size: 30rpx;
  background: #fafaf8;
}
.hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 28rpx;
}