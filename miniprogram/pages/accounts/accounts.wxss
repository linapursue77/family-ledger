.asset-card {
  background: linear-gradient(135deg, #7f77dd, #534ab7);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 24rpx 16rpx;
}
.asset-card .label {
  font-size: 22rpx;
  opacity: 0.8;
}
.asset-card .amount {
  font-size: 56rpx;
  font-weight: 600;
  margin: 8rpx 0;
  font-variant-numeric: tabular-nums;
}
.asset-card .change {
  font-size: 22rpx;
  opacity: 0.9;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.group-total {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  font-variant-numeric: tabular-nums;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-body);
  margin-bottom: 0;
}

.acc-icon {
  font-size: 40rpx;
}
.acc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.acc-name {
  font-size: 30rpx;
  font-weight: 600;
}
.acc-book {
  font-size: 22rpx;
}
.acc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.acc-balance {
  font-weight: 700;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
}
.acc-profit,
.acc-vis {
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}
.empty-sm {
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 28rpx 0 8rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #7f77dd;
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(127, 119, 221, 0.4);
  z-index: 40;
}

/* 表单 */
.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.field-row input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.field-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-main);
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 28rpx;
}
.switch-label {
  display: flex;
  flex-direction: column;
}
.switch-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.icon-cell {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #f1efe8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.icon-cell.active {
  background: var(--primary-light);
  border: 2rpx solid var(--primary);
}

.action-item {
  padding: 28rpx 4rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--divider);
}
.action-item.danger {
  color: var(--expense);
  border-bottom: none;
}

.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.mode-btn {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.mode-btn.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.form-note {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  padding: 16rpx 4rpx 0;
}

/* 收益总额：盈亏开关 + 数字输入 */
.profit-row {
  align-items: flex-start;
}
.profit-main {
  flex: 1;
}
.sign-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.sign-btn {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  font-size: 24rpx;
  border-radius: 12rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.sign-plus.on {
  background: #e1f5ee;
  color: #0f6e56;
  font-weight: 600;
}
.sign-minus.on {
  background: #fcecec;
  color: #a32d2d;
  font-weight: 600;
}
.profit-input {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.profit-sign {
  font-size: 26rpx;
  color: var(--text-muted);
}
.profit-input input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
