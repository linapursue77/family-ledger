/* 时间控件 */
.time-picker-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #f7f6f3;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 8rpx;
}
.time-picker-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.time-picker-icon {
  font-size: 28rpx;
}
.time-picker-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #26215c;
}
.time-picker-arrow {
  font-size: 32rpx;
  color: #c8c6c0;
}
.time-picker-options {
  display: none;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e8e8e8;
}
.time-picker-options.show {
  display: flex;
}
.time-picker-option {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  background: #f1efe8;
  color: #5f5e5a;
}
.time-picker-option.active {
  background: #eeedfe;
  color: #7f77dd;
  font-weight: 500;
}
.time-picker-option.custom {
  background: linear-gradient(135deg, #7f77dd 0%, #9b8fe8 100%);
  color: #fff;
  font-weight: 500;
}
.time-range-display {
  padding: 12rpx 20rpx;
  background: #f7f6f3;
  border-radius: 12rpx;
  margin: 0 24rpx 16rpx;
  text-align: center;
}
.time-range-text {
  font-size: 22rpx;
  color: #888780;
}

/* 资产卡 */
.asset-card {
  background: linear-gradient(135deg, #7f77dd, #534ab7);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 16rpx;
}
.asset-card .label {
  font-size: 22rpx;
  opacity: 0.8;
}
.asset-card .amount {
  font-size: 56rpx;
  font-weight: 600;
  margin: 8rpx 0;
}
.asset-card .change {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 收支切换 */
.income-expense-toggle {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
}
.toggle-btn {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
}
.toggle-btn.active {
  background: #eeedfe;
  border-color: #7f77dd;
  color: #7f77dd;
  font-weight: 500;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 24rpx 16rpx;
  border: 1rpx solid #e8e8e8;
}
.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.summary-main {
  display: flex;
  flex-direction: column;
}
.summary-label {
  font-size: 24rpx;
  color: #888780;
}
.summary-value {
  font-size: 48rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.summary-sub {
  font-size: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2c2a;
  margin-bottom: 20rpx;
}

/* 饼图 + 图例 */
.pie-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 20rpx;
}
.pie {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.mini-legend {
  flex: 1;
}
.legend-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}
.legend-name {
  font-size: 26rpx;
  color: #5f5e5a;
}
.legend-pct {
  font-size: 26rpx;
  color: #888780;
}

/* 分类列表 */
.category-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}
.category-item:last-child {
  border-bottom: none;
}
.category-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.category-info {
  flex: 1;
}
.category-name {
  font-size: 26rpx;
  font-weight: 500;
}
.category-percent {
  font-size: 22rpx;
  color: #888780;
  margin-left: 8rpx;
}
.progress-bar {
  height: 10rpx;
  background: #f1efe8;
  border-radius: 6rpx;
  margin-top: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 6rpx;
}
.category-amount {
  font-size: 26rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

/* 浮动按钮 */
.floating-btn {
  position: fixed;
  bottom: 160rpx;
  right: 32rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #7f77dd;
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(127, 119, 221, 0.4);
  z-index: 40;
}

/* 账户弹窗 */
.acc-icon {
  font-size: 40rpx;
}
.acc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.acc-name {
  font-size: 30rpx;
  font-weight: 600;
}
.acc-book {
  font-size: 24rpx;
}
.acc-balance {
  font-weight: 700;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
}

/* 分类明细 */
.tx-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.tx-merchant {
  font-size: 28rpx;
}
.tx-date {
  font-size: 24rpx;
}
.tx-amount {
  font-weight: 700;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}