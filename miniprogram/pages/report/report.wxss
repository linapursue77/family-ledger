/* 报告页：结构与配色对齐 H5 Report.vue */
.report-page {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}
/* ★ 全局 .card 自带 margin: 0 24rpx，而本页容器已有左右 padding，
   这里必须把左右 margin 清零，否则会双重缩进 */
.report-page .card {
  padding: 24rpx 28rpx;
  margin: 0 0 20rpx;
}

.navbar {
  padding: 20rpx 0 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.navbar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}
.range-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ---------- 周期 / 账户 chips ---------- */
.chip-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  /* gap 在部分微信 WebView 下不稳，用 margin 兜底 */
  white-space: nowrap;
  overflow-x: auto;
}
.chip-row .chip {
  flex: none;
  margin-right: 16rpx;
}
.chip-row .chip:last-child {
  margin-right: 0;
}

/* 账户筛选条：单独一行，但只占一行高度，不抢首屏 */
.account-row {
  margin-top: -4rpx;
}

/* ---------- 汇总卡 ---------- */
.hero {
  color: #fff;
  border: none;
}
.hero-expense {
  background: linear-gradient(135deg, #e24b4a, #b8322f);
}
.hero-income {
  background: linear-gradient(135deg, #1d9e75, #157a5b);
}
/* 卡内收支切换：半透明白胶囊，选中态实白底 + 主色字，
   这样「支出/收入」切换不占额外一条，首屏高度省下 120rpx 左右 */
.hero-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.hero-tab {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.18);
}
.hero-tab.on {
  background: #fff;
  color: var(--text-main);
  font-weight: 600;
}
.hero-amount {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.15;
  margin: 4rpx 0;
  font-variant-numeric: tabular-nums;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
}
.hero-stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.28);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-b {
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.stat-l {
  margin-top: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

/* ---------- 智能分析 ---------- */
.sec-title {
  display: flex;
  align-items: baseline;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
}
.insight-sub {
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-muted);
}
.unit {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-muted);
}
.ai-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.ai-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
  min-width: 0;
}
.ai-switch {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f1efe8;
  color: #888780;
  font-size: 22rpx;
  font-weight: 500;
}
.ai-switch.on {
  background: var(--primary);
  color: #fff;
}
.ai-switch.off {
  opacity: 0.45;
}
.ai-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 8rpx;
}
.insight-loading,
.insight-error {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 12rpx 0;
}
.retry {
  color: var(--primary);
  margin-left: 16rpx;
}
.insight-hero {
  display: flex;
  align-items: center;
}
.score-ring {
  flex: none;
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  position: relative;
}
/* 伪元素在小程序不可用，用真 view 挖出中间的白圆 */
.score-inner {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.score-unit {
  font-size: 20rpx;
  color: var(--text-muted);
}
.insight-hero-main {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}
.score-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.score-text {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
  margin-top: 8rpx;
}
.insight-cmp {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}
.insight-item {
  display: flex;
  margin-top: 24rpx;
  padding: 16rpx 0 16rpx 20rpx;
  border-left: 6rpx solid #e8e8e8;
  background: #faf9f6;
  border-radius: 0 16rpx 16rpx 0;
}
.insight-item.lv-good {
  border-left-color: #1d9e75;
}
.insight-item.lv-info {
  border-left-color: #7f77dd;
}
.insight-item.lv-warn {
  border-left-color: #ef9f27;
}
.insight-item.lv-danger {
  border-left-color: #e24b4a;
}
.ins-ic {
  font-size: 32rpx;
  line-height: 1.4;
  flex: none;
  margin-right: 20rpx;
}
.ins-main {
  min-width: 0;
  flex: 1;
}
.ins-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
}
.ins-detail {
  font-size: 22rpx;
  color: var(--text-body);
  line-height: 1.5;
  margin-top: 4rpx;
}
.ins-sug {
  font-size: 22rpx;
  color: var(--primary);
  line-height: 1.5;
  margin-top: 6rpx;
}

/* 洞察折叠按钮：居中的轻量文字按钮，不抢内容视觉 */
.insight-more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  padding: 10rpx 0;
}

/* ---------- 分类环形图（conic-gradient 零依赖） ---------- */
.pie-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--divider);
}
.donut {
  position: relative;
  flex: none;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
}
.donut-hole {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  border-radius: 50%;
  background: #fff;
}
.mini-legend {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
  max-height: 220rpx;
  overflow-y: auto;
}
.legend-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
}
.legend-name {
  font-size: 26rpx;
  color: var(--text-sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}
.legend-pct {
  flex: none;
  font-size: 26rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

/* ---------- 分类 / 成员 通用行 ---------- */
.cat-row,
.mem-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
  flex-wrap: nowrap;
}
.cat-row:last-child,
.mem-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: var(--divider);
  flex: none;
  margin-right: 20rpx;
}
.cat-main,
.mem-main {
  flex: 1;
  min-width: 0;
}
.cat-line,
.mem-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.cat-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-body);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-right {
  display: flex;
  align-items: baseline;
  flex: none;
}
.cat-amt,
.mem-amt {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--text-main);
}
.cat-pct {
  font-size: 24rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  min-width: 92rpx;
  text-align: right;
  margin-left: 16rpx;
}
.mem-name {
  font-weight: 500;
  font-size: 30rpx;
  color: var(--text-body);
}
.mem-pct {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-muted);
  margin-left: 8rpx;
}
.cat-count {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: none;
  margin-left: 20rpx;
}
.bar {
  height: 12rpx;
  background: var(--divider);
  border-radius: 6rpx;
  overflow: hidden;
}
.bar-fill {
  display: block;
  height: 100%;
  border-radius: 6rpx;
}
.bar-fill.fill-expense {
  background: var(--expense);
}
.bar-fill.fill-income {
  background: var(--income);
}
.mem-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  flex: none;
  margin-right: 20rpx;
}

/* ---------- 账户收支 ---------- */
.acc-summary {
  display: flex;
}
.as-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.as-label {
  font-size: 24rpx;
  color: var(--text-sub);
}
.as-val {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ---------- 趋势图 ---------- */
.trend-legend {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}
.tl-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-sub);
  margin-left: 24rpx;
}
.tl-dot {
  width: 20rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
.tl-dot.inc {
  background: #1d9e75;
}
.tl-dot.exp {
  background: #e24b4a;
}
.trend {
  width: 100%;
  height: 400rpx;
  display: block;
}

.empty-sm {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 16rpx 0;
  text-align: center;
}
.loading-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 16rpx 0;
}

/* ---------- 分类逐笔明细弹窗 ---------- */
.cat-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.cat-card {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--divider);
}
.cat-head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}
.cat-head-close {
  font-size: 40rpx;
  color: var(--text-muted);
  padding: 0 8rpx;
  line-height: 1;
}
.cat-body {
  flex: 1;
  min-height: 0;
  padding: 28rpx;
  box-sizing: border-box;
}
.cat-summary {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #faf9f6;
}
.cat-summary-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex: none;
  margin-right: 20rpx;
}
.cat-summary-info {
  flex: 1;
  min-width: 0;
}
.cat-summary-name {
  font-size: 28rpx;
  color: var(--text-sub);
}
.cat-summary-amount {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.cat-filters {
  display: flex;
  margin: 24rpx 0;
  white-space: nowrap;
  overflow-x: auto;
}
.cat-filter {
  flex: none;
  margin-right: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f1efe8;
  color: var(--text-sub);
  font-size: 24rpx;
}
.cat-filter:last-child {
  margin-right: 0;
}
.cat-filter.active {
  background: var(--primary);
  color: #fff;
}
.cat-list {
  max-height: 60vh;
  overflow-y: auto;
}
.cat-tx {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
  flex-wrap: nowrap;
}
.cat-tx-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex: none;
  margin-right: 20rpx;
}
.cat-tx-info {
  flex: 1;
  min-width: 0;
}
.cat-tx-title {
  font-size: 28rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-tx-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-tx-amount {
  flex: none;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.cat-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}
