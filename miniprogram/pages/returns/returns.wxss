.filter-bar {
  padding: 0 24rpx 16rpx;
}

.asset-card {
  background: linear-gradient(135deg, #7f77dd, #534ab7);
  color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 24rpx 16rpx;
}
.asset-card .label {
  font-size: 22rpx;
  opacity: 0.8;
}
.asset-card .amount {
  font-size: 56rpx;
  font-weight: 600;
  margin: 8rpx 0;
  font-variant-numeric: tabular-nums;
}
.hero-row {
  display: flex;
  gap: 32rpx;
}
.hero-cell {
  display: flex;
  flex-direction: column;
}
.hero-label {
  font-size: 20rpx;
  opacity: 0.8;
}
.hero-value {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.hero-value.up {
  color: #b9f5d8;
}
.hero-value.down {
  color: #ffd7d7;
}

.split-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 20rpx;
}
.split-principal {
  height: 100%;
  background: #fff;
}
.split-legend {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-body);
  margin-bottom: 20rpx;
}

.year-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.year-main {
  display: flex;
  flex-direction: column;
}
.year-value {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.year-rate {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}
.year-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.side-label {
  font-size: 22rpx;
  color: var(--text-muted);
}
.side-value {
  font-size: 30rpx;
  font-weight: 600;
}

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.kv-row:last-of-type {
  border-bottom: none;
}
.kv-label {
  font-size: 28rpx;
  color: var(--text-sub);
}
.kv-value {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.kv-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

/* 柱状图：容器上下各一半，正柱往上、负柱往下 */
.chart {
  height: 260rpx;
  position: relative;
}
.chart-axis {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  background: var(--border);
}
.chart-bars {
  display: flex;
  align-items: stretch;
  height: 100%;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-wrap {
  flex: 1;
  width: 100%;
  position: relative;
}
.bar {
  position: absolute;
  left: 20%;
  width: 60%;
  border-radius: 4rpx;
}
.bar.up {
  bottom: 50%;
  background: var(--income);
}
.bar.down {
  top: 50%;
  background: var(--expense);
}
.bar-label {
  font-size: 18rpx;
  color: var(--text-muted);
  height: 32rpx;
  line-height: 32rpx;
}
.chart-note {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.tab-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.tab-btn.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.acc-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.acc-row:last-child {
  border-bottom: none;
}
.acc-icon {
  font-size: 40rpx;
}
.acc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.acc-name {
  font-size: 30rpx;
  font-weight: 600;
}
.acc-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.acc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.acc-profit {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.acc-rate {
  font-size: 22rpx;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.month-row:last-child {
  border-bottom: none;
}
.month-label {
  font-size: 28rpx;
}
.month-value {
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.empty-sm {
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 24rpx 0 8rpx;
}

.empty-wrap {
  padding: 80rpx 48rpx;
  text-align: center;
}
.empty-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}
.go-btn {
  width: 60%;
  margin: 0 auto;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.field-label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.field-row input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.mode-btn {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: #f1efe8;
  color: var(--text-sub);
}
.mode-btn.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.form-note {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
  padding-top: 16rpx;
}
