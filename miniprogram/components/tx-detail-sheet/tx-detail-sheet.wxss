.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 8rpx 0 40rpx;
  max-height: 84vh;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f1efe8;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #26215c;
}
.sheet-close {
  font-size: 32rpx;
  color: #b0aeaa;
  padding: 0 8rpx;
}

.sheet-loading {
  padding: 80rpx 0;
  text-align: center;
  color: #888780;
  font-size: 26rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.hero-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.hero-amount {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.hero-amount.in {
  color: #1d9e75;
}
.hero-amount.out {
  color: #26215c;
}
.hero-type {
  font-size: 24rpx;
  color: #888780;
  margin-top: 6rpx;
}

.kv-list {
  padding: 0 32rpx;
}
.kv {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f7f6f2;
  font-size: 26rpx;
}
.kv-k {
  width: 180rpx;
  color: #888780;
  flex-shrink: 0;
}
.kv-v {
  flex: 1;
  color: #2c2c2a;
  word-break: break-all;
}

.loan-tip {
  margin: 28rpx 32rpx 0;
  background: #fff8e6;
  color: #8a6100;
  font-size: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
}
.act-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.act-btn.edit {
  background: #eeedfe;
  color: #534ab7;
}
.act-btn.del {
  background: #fceaea;
  color: #d03b3b;
}
.act-btn.disabled {
  opacity: 0.5;
}
