backend/certs/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 本项目运行时产物 ----
backend/logs/
backend/media/
backend/db.sqlite3
*.log
*.log.*

# ---- 前端 ----
node_modules/
frontend/.vite/
